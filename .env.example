# Build local a partir do código. GHCR/Dockge: deploy/.env.example.
# Docker Compose settings. Do not place panel passwords/tokens in this file.
RESMAN_PORT=48190
RESMAN_BIND=127.0.0.1
RESMAN_ALLOWED_HOSTS=servip2p.com
RESMAN_PRIVATE_HOSTS=
RESMAN_PUBLIC_ORIGIN=
# Chromium já está incluído e habilitado. Não exige opt-in nem download em execução.
RESMAN_DOCKER_TARGET=runtime
RESMAN_VERSION=0.1.0
# For HTTPS reverse proxy: set the exact origin, e.g. https://revendas.example.com
# O target browser é um alias de compatibilidade; runtime também inclui Chromium.
