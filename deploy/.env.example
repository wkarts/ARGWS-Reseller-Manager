# Somente configurações públicas. NÃO coloque senhas/tokens do painel aqui.
# A imagem precisa ter sido publicada pelo workflow antes do primeiro pull.
RESMAN_IMAGE=ghcr.io/wkarts/argws-reseller-manager:latest
# 0.0.0.0 permite acessar pela rede. Use 127.0.0.1 atrás de proxy no mesmo host.
RESMAN_BIND=0.0.0.0
RESMAN_PORT=48190
RESMAN_ALLOWED_HOSTS=servip2p.com
RESMAN_PRIVATE_HOSTS=
# Preencha com a origem exata do seu proxy HTTPS, sem barra final.
RESMAN_PUBLIC_ORIGIN=
# As tags antigas com sufixo -browser continuam compatíveis.
# Chromium já está incluído e habilitado. Não exige opt-in nem download em execução.
